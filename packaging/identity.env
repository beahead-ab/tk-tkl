# Vilken installation det här paketet blir. Läses av install.sh och scripts/install-raspberry-pi.sh.
# Charlottendal: cda-tkl från beahead-ab/cda-tkl. En annan station har sin egen, till exempel Träkvista:
#   TKL_ID=tk-tkl  TKL_NAME=Träkvista  TKL_STATION=trakvista  TKL_REPOSITORY=beahead-ab/Tk-TKL
# TKL_ID blir systemanvändaren, tjänsterna (TKL_ID.service, TKL_ID-update) och katalogerna /opt, /etc och /var/lib.
TKL_ID=tk-tkl
TKL_NAME=Träkvista
TKL_STATION=trakvista
TKL_REPOSITORY=beahead-ab/Tk-TKL
