[Unit]
Description=Charlottendal TKL
Wants=network-online.target cda-tkl-simulator.service
After=network-online.target cda-tkl-simulator.service

[Service]
Type=simple
User=cda-tkl
Group=cda-tkl
# Live (0.78.0): TKL startar LocoBufferns gateway själv och behöver USB-serieporten.
SupplementaryGroups=dialout
WorkingDirectory=/opt/cda-tkl/current
EnvironmentFile=/etc/cda-tkl/app.env
ExecStart=/opt/cda-tkl/node/bin/node src/server.mjs
Restart=always
RestartSec=2
TimeoutStopSec=10
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/cda-tkl
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
